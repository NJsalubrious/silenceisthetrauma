IMG_ROOT = os.path.normpath(os.path.join(ROOT, 'assets', 'images', 'posts'))
FOLDER = 'podcast_posts_KIRB_ZSM'


def img(name):
    on_disk = os.path.join(IMG_ROOT, FOLDER, name)
    if not os.path.isfile(on_disk):
        raise SystemExit(f'IMAGE MISSING: {FOLDER}/{name}')
    return f'../assets/images/posts/{FOLDER}/{name}'


