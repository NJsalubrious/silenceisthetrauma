    for p in posts:
        h = p.get('handle')
        if h and h not in profile_of:
            profile_of[h] = (p.get('display_name'), p.get('avatar'))
    h = NEW_POST['handle']
    if h not in profile_of:
        raise SystemExit(f'HANDLE NOT IN posts.json: {h}')
    display, avatar = profile_of[h]
    h8 = hashlib.sha1(
        (h + NEW_POST['timestamp'] + NEW_POST['content'][:40]).encode('utf-8')
    ).hexdigest()[:8]
    pid = f'kirb_throwback_{h8}'
    if pid in by_id:
        raise SystemExit(f'ID COLLISION: {pid}')
    new_post = {
        'id': pid,
        'handle': h,
        'display_name': display,
        'avatar': avatar,
        'content': NEW_POST['content'],
        'timestamp': NEW_POST['timestamp'],
        'reply_to': None,
        'link': None,
        'image': NEW_POST['image_path'],
        'image_alt': NEW_POST['image_alt'],
        'type': 'post',
        'pinned': False,
    }
    posts.append(new_post)

    with open(CUR, 'w', encoding='utf-8', newline='\n') as f:
        json.dump(posts, f, indent=2, ensure_ascii=False)
    json.load(open(CUR, 'r', encoding='utf-8'))

    print(f'Backup: posts.json.bak.{stamp}_kirb_image_fix')
    print(f'Stripped image from: {stripped}')
    print(f'Image-patched:       {patched}')
    print(f'Appended:            {pid}')
    print(f'Total posts now:     {len(posts)}')


