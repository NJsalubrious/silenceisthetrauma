PAGES_DIR = os.path.join(ROOT, 'people')

IMG_RE = re.compile(r'<img\b[^>]*>', re.IGNORECASE)
ALT_RE = re.compile(r'\balt\s*=\s*"([^"]*)"', re.IGNORECASE)
SRC_RE = re.compile(r'\bsrc\s*=\s*"([^"]*)"', re.IGNORECASE)


def suggest_alt_from_src(src):
    base = os.path.basename(src)
    stem = re.sub(r'\.[a-z0-9]+$', '', base, flags=re.IGNORECASE)
    # Strip trailing _N digit chunks (e.g. _1, _02)
    stem = re.sub(r'(_\d+)+$', '', stem)
    # Strip UUID-like blocks
    stem = re.sub(r'_[0-9a-f]{8}-[0-9a-f-]{20,}', '', stem, flags=re.IGNORECASE)
    # camelCase → spaces
    stem = re.sub(r'([a-z])([A-Z])', r'\1 \2', stem)
    stem = stem.replace('_', ' ').replace('-', ' ')
    stem = re.sub(r'\s+', ' ', stem).strip()
    return stem


def main():
    pages = sorted([p for p in os.listdir(PAGES_DIR)
                    if p.lower().endswith('.html')])

    total_imgs = 0
    missing_alt = []
    empty_alt = []
    has_alt = 0

    for fname in pages:
        path = os.path.join(PAGES_DIR, fname)
        with open(path, 'r', encoding='utf-8') as f:
            text = f.read()
        for m in IMG_RE.finditer(text):
            total_imgs += 1
            tag = m.group(0)
            alt_match = ALT_RE.search(tag)
            src_match = SRC_RE.search(tag)
            src = src_match.group(1) if src_match else '(no src)'
            if alt_match is None:
                missing_alt.append((fname, src, suggest_alt_from_src(src)))
            elif alt_match.group(1).strip() == '':
                empty_alt.append((fname, src, suggest_alt_from_src(src)))
            else:
                has_alt += 1

    print(f'=== <img> ALT AUDIT ===')
    print(f'Pages scanned:       {len(pages)}')
    print(f'Total <img> tags:    {total_imgs}')
    print(f'  with non-empty alt: {has_alt}')
    print(f'  EMPTY alt="":       {len(empty_alt)}')
    print(f'  MISSING alt attr:   {len(missing_alt)}')

