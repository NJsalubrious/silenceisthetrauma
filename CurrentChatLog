        "EP 045 title plate — Dominic Ryker seated in the KIRB studio, "
        "smiling at the hosts, June 2024."
    ),
}


def main():
    posts = json.load(open(CUR, 'r', encoding='utf-8'))
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    with open(CUR + f'.bak.{stamp}_kirb_image_fix', 'w',
              encoding='utf-8', newline='\n') as f:
        json.dump(posts, f, indent=2, ensure_ascii=False)

    by_id = {p.get('id'): p for p in posts if p.get('id')}

    stripped = []
    for pid in STRIP_IMAGE_IDS:
        if pid not in by_id:
            raise SystemExit(f'STRIP POST NOT FOUND: {pid}')
        by_id[pid]['image'] = None
        by_id[pid]['image_alt'] = None
        stripped.append(pid)

    patched = []
    for pid, patch in IMAGE_PATCHES.items():
        if pid not in by_id:
            raise SystemExit(f'PATCH POST NOT FOUND: {pid}')
        for k, v in patch.items():
            by_id[pid][k] = v
        patched.append(pid)

    # Build new post; copy display_name/avatar from existing KIRB post.
