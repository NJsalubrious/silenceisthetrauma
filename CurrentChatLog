"""Inject the comprehensive meta block into every character page
(/people/*.html) for profiles whose links_to points there.

Injects ONLY tags that are not already present (per-tag check).
Backs up each modified file.

Block (in this order):
  - meta name="robots" content="index, follow, max-image-preview:large"
  - meta name="description"   (only if missing)
  - meta name="keywords"      (approach B — derived from profile)
  - meta name="author"        (Silence Is The Trauma)
  - og:type, og:title, og:description, og:site_name, og:locale
  - og:image, og:image:width, og:image:height
  - twitter:card, twitter:title, twitter:description, twitter:image
"""
import json, os, re, html, sys
from datetime import datetime
sys.stdout.reconfigure(encoding='utf-8')

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
PROFILES = os.path.join(HERE, 'profiles.json')
SITE_BASE = 'https://silenceisthetrauma.com'
SHARE_REL = 'assets/images/social_share'
PAGES_DIR = os.path.join(ROOT, 'people')

# Words too generic to keyword on
STOPWORDS = set('''
the a an and or of in to for on at by from with is are was were be been
being it this that these those his her their our my your i you we he she
they but not no nor as if then than so very too can will would could should
have has had do does did me her him us them yours its also one two three
some any all most least more less other another such only just like there
'''.split())

# Base stem every character gets
BASE_KEYWORDS = [
    'silence is the trauma',
    'ryker case',
    'satirical crime fiction',
    'art installation',
    'pixelstortion',
]


def is_local_people_link(v):
    if not v:
        return False
    v = v.strip()
    if v.startswith(('http://', 'https://', '//')):
        return False
    return '/people/' in v.replace('\\', '/')


def resolve_page(profile):
    """Resolve profile.links_to to an absolute HTML path on disk."""
    rel = profile.get('links_to', '').strip().replace('\\', '/')
    # Strip leading ../ and locate under ROOT/people
    rel = rel.lstrip('./')
    while rel.startswith('../'):
        rel = rel[3:]
    if rel.startswith('people/'):
        candidate = os.path.join(ROOT, rel)
        if os.path.isfile(candidate):
            return candidate
    # Fallback: maybe links_to is just a filename
    candidate = os.path.join(ROOT, 'people', os.path.basename(rel))
    if os.path.isfile(candidate):
        return candidate
    return None


def share_card_url(profile_id):
    return f'{SITE_BASE}/{SHARE_REL}/{profile_id}.jpg'


def derive_description(profile, html_text):
    """Build a meta description from profile data. Only used when the
    HTML doesn't already have one."""
    bio = (profile.get('bio') or '').strip()
    if bio:
        # If bio short, append a generic context line
        if len(bio) < 80:
            return f'{bio} — A character in Silence Is The Trauma, an art-installation crime fiction project.'
        return bio
    quote = (profile.get('quote') or '').strip().strip('"')
    if quote:
        return f'"{quote}" — Silence Is The Trauma.'
    return f"{profile.get('display_name')} — character page in Silence Is The Trauma, a satirical crime-fiction art installation."


def derive_keywords(profile):
    name = (profile.get('display_name') or '').lower().strip()
    handle = (profile.get('handle') or '').lstrip('@').strip()
    bio = (profile.get('bio') or '').lower()
    quote = (profile.get('quote') or '').lower()
    tier = (profile.get('tier') or '').lower()

    kws = []
    if name:
        kws.append(name)
    if handle:
        kws.append(handle.replace('_', ' '))
        kws.append(f'@{handle}')

    # Tokens from bio + quote — keep distinct multi-letter words
    text = (bio + ' ' + quote)
    text = re.sub(r'[^a-z0-9 \-]+', ' ', text)
    tokens = [t.strip() for t in text.split() if len(t) > 3 and t not in STOPWORDS]
    # Take up to 6 distinct content tokens
    seen, extra = set(), []
    for t in tokens:
        if t in seen:
            continue
        seen.add(t)
        extra.append(t)
        if len(extra) >= 6:
            break
    kws.extend(extra)

    # Tier descriptor
    if tier:
        kws.append(f'{tier} character')

    # Base
    kws.extend(BASE_KEYWORDS)

    # Dedupe preserving order
    seen, deduped = set(), []
    for k in kws:
        if k not in seen and k:
            seen.add(k)
            deduped.append(k)
    return ', '.join(deduped[:14])


def derive_title(profile, current_title):
    """Use the existing <title> if it's present and meaningful."""
    if current_title and current_title.strip():
        return current_title.strip()
    return f"{profile.get('display_name')} | Silence Is The Trauma"


def existing_title(html_text):
    m = re.search(r'<title[^>]*>(.*?)</title>', html_text, re.IGNORECASE | re.DOTALL)
    return m.group(1).strip() if m else ''


def has_tag(html_text, kind, key, value):
    """Return True if a meta/link tag with the given key=value is present."""
    if kind == 'name':
        pattern = rf'<meta\s+name=["\']?{re.escape(key)}["\']?[^>]*>'
    elif kind == 'property':
        pattern = rf'<meta\s+property=["\']?{re.escape(key)}["\']?[^>]*>'
    else:
        return False
    return re.search(pattern, html_text, re.IGNORECASE) is not None


def build_meta_block(profile, image_url, html_text):
    title = derive_title(profile, existing_title(html_text))
    has_desc = has_tag(html_text, 'name', 'description', None)
    desc = None if has_desc else derive_description(profile, html_text)
    keywords = derive_keywords(profile)

    # Sanitise for HTML attribute context
    def att(s):
        return html.escape(s or '', quote=True)

    parts = ['\n    <!-- BATCH meta block (Phase 1 SEO) -->']

    if not has_tag(html_text, 'name', 'robots', None):
        parts.append('    <meta name="robots" content="index, follow, max-image-preview:large">')
    if not has_desc:
        parts.append(f'    <meta name="description" content="{att(desc)}">')
    if not has_tag(html_text, 'name', 'keywords', None):
        parts.append(f'    <meta name="keywords" content="{att(keywords)}">')
    if not has_tag(html_text, 'name', 'author', None):
        parts.append('    <meta name="author" content="Silence Is The Trauma">')

    # Open Graph
    if not has_tag(html_text, 'property', 'og:type', None):
        parts.append('    <meta property="og:type" content="profile">')
    if not has_tag(html_text, 'property', 'og:title', None):
        parts.append(f'    <meta property="og:title" content="{att(title)}">')
    if not has_tag(html_text, 'property', 'og:description', None):
        og_desc = desc if desc else _grab_existing_desc(html_text) or title
        parts.append(f'    <meta property="og:description" content="{att(og_desc)}">')
    if not has_tag(html_text, 'property', 'og:site_name', None):
        parts.append('    <meta property="og:site_name" content="Silence Is The Trauma">')
    if not has_tag(html_text, 'property', 'og:locale', None):
        parts.append('    <meta property="og:locale" content="en_AU">')
    if image_url and not has_tag(html_text, 'property', 'og:image', None):
        parts.append(f'    <meta property="og:image" content="{att(image_url)}">')
        parts.append('    <meta property="og:image:width" content="1200">')
        parts.append('    <meta property="og:image:height" content="630">')

    # Twitter
    if not has_tag(html_text, 'name', 'twitter:card', None):
        parts.append('    <meta name="twitter:card" content="summary_large_image">')
    if not has_tag(html_text, 'name', 'twitter:title', None):
        parts.append(f'    <meta name="twitter:title" content="{att(title)}">')
    if not has_tag(html_text, 'name', 'twitter:description', None):
        tw_desc = desc if desc else _grab_existing_desc(html_text) or title
        parts.append(f'    <meta name="twitter:description" content="{att(tw_desc)}">')
    if image_url and not has_tag(html_text, 'name', 'twitter:image', None):
        parts.append(f'    <meta name="twitter:image" content="{att(image_url)}">')

    return ('\n'.join(parts) + '\n') if len(parts) > 1 else ''


def _grab_existing_desc(html_text):
    m = re.search(r'<meta\s+name=["\']?description["\']?\s+content=["\'](.*?)["\']',
                  html_text, re.IGNORECASE | re.DOTALL)
    return m.group(1).strip() if m else None


def inject(page_path, profile, image_url):
    with open(page_path, 'r', encoding='utf-8') as f:
        html_text = f.read()

    block = build_meta_block(profile, image_url, html_text)
    if not block.strip():
        return False, 'all-present'

    # Insert after og:url if present, else after <head>
    og_url = re.search(r'<meta\s+property=["\']?og:url["\']?[^>]*>', html_text, re.IGNORECASE)
    if og_url:
        idx = og_url.end()
    else:
        head = re.search(r'<head[^>]*>', html_text, re.IGNORECASE)
        if not head:
            return False, 'no <head>'
        idx = head.end()

    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    with open(page_path + f'.bak.{stamp}_meta', 'w',
              encoding='utf-8', newline='\n') as f:
        f.write(html_text)

    new_html = html_text[:idx] + block + html_text[idx:]
    with open(page_path, 'w', encoding='utf-8', newline='\n') as f:
        f.write(new_html)
    return True, None


def main():
    profiles = json.load(open(PROFILES, 'r', encoding='utf-8'))

    # Dedupe by page path: same page can be linked to from multiple profiles
    page_to_profile = {}
    skipped = []
    for p in profiles:
        if not is_local_people_link(p.get('links_to')):
            skipped.append(p)
            continue
        page = resolve_page(p)
        if not page:
            skipped.append(p)
            continue
        # If a page already mapped, prefer profile with verified or primary tier
        if page in page_to_profile:
            existing = page_to_profile[page]
            if p.get('verified') and not existing.get('verified'):
                page_to_profile[page] = p
            elif p.get('tier') == 'primary' and existing.get('tier') != 'primary':
                page_to_profile[page] = p
        else:
            page_to_profile[page] = p

    print(f'Pages to process: {len(page_to_profile)}')
    print(f'Profiles skipped (no local /people/ link): {len(skipped)}\n')

    success = 0
    all_present = 0
    failed = []
    for page, profile in page_to_profile.items():
        pid = profile.get('id') or profile['handle'].lstrip('@')
        share_path = os.path.join(ROOT, SHARE_REL.replace('/', os.sep), pid + '.jpg')
        image_url = share_card_url(pid) if os.path.isfile(share_path) else None

        ok, err = inject(page, profile, image_url)
        if ok:
            success += 1
        elif err == 'all-present':
            all_present += 1
        else:
            failed.append((os.path.basename(page), err))

    print(f'Injected new meta into: {success} pages')
    print(f'Already complete:       {all_present} pages')
    if failed:
        print(f'Failed:                 {len(failed)}')
        for f, e in failed:
            print(f'   {f}: {e}')


if __name__ == '__main__':
    main()
