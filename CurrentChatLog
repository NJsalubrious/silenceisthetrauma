import json, os, hashlib, random
from datetime import datetime, timedelta

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
CUR = os.path.join(HERE, 'posts.json')
IMG_ROOT = os.path.normpath(os.path.join(ROOT, 'assets', 'images', 'posts'))
FOLDER = 'russian_militants_posts'
SEED = 24601  # deterministic

HANDLES = ['@gleb_r', '@lev_r', '@ratibor_r']

# Date range
START = datetime(2026, 4, 30, 0, 0, 0)
END   = datetime(2026, 8, 10, 0, 0, 0)


def img(name):
    on_disk = os.path.join(IMG_ROOT, FOLDER, name)
    if not os.path.isfile(on_disk):
        raise SystemExit(f'IMAGE MISSING: {FOLDER}/{name}')
    return f'../assets/images/posts/{FOLDER}/{name}'


def main():
    rng = random.Random(SEED)

    # Image list — alphabetical from disk
    files = sorted([f for f in os.listdir(os.path.join(IMG_ROOT, FOLDER))
                    if f.lower().endswith('.jpg')])
    if len(files) != 21:
        print(f'WARN: expected 21 images, found {len(files)}')

    # Generate evenly-spaced timestamps with jitter
    total_days = (END - START).days
    n = len(files)
    base_step = total_days / n
    timestamps = []
    for i in range(n):
        # base position + jitter ±2 days
        base = START + timedelta(days=base_step * i)
        jitter_hours = rng.uniform(-48, 48)
        # random hour-of-day too — militants don't post on a schedule
        ts = base + timedelta(hours=jitter_hours)
        # Replace the hour-of-day with a random hour, keep day-shift
        ts = ts.replace(
            hour=rng.randint(0, 23),
            minute=rng.choice([0, 7, 15, 22, 30, 38, 45, 53]),
            second=0,
        )
        timestamps.append(ts)
    timestamps.sort()

    # Shuffle which handle gets which image — keep handle rotation random
    handle_order = []
    pool = HANDLES * 7  # 21 = 3*7
    rng.shuffle(pool)
    handle_order = pool[:n]

    # Shuffle which image goes where (so the file order doesn't lock the chronology)
    image_order = list(files)
    rng.shuffle(image_order)

    # Load posts, backup
    posts = json.load(open(CUR, 'r', encoding='utf-8'))
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    with open(CUR + f'.bak.{stamp}_russian_militants', 'w',
              encoding='utf-8', newline='\n') as f:
        json.dump(posts, f, indent=2, ensure_ascii=False)

    profile_of = {}
    for p in posts:
        h = p.get('handle')
        if h and h not in profile_of:
            profile_of[h] = (p.get('display_name'), p.get('avatar'))

    for h in HANDLES:
        if h not in profile_of:
            raise SystemExit(f'HANDLE NOT IN posts.json: {h}')

    existing_ids = {p.get('id') for p in posts if p.get('id')}
    added = []
    for ts, handle, fname in zip(timestamps, handle_order, image_order):
        display, avatar = profile_of[handle]
        ts_iso = ts.strftime('%Y-%m-%dT%H:%M:%SZ')
        h8 = hashlib.sha1(
            (handle + ts_iso + fname).encode('utf-8')
        ).hexdigest()[:8]
        slug = handle.lstrip('@')
        pid = f'{slug}_militant_{h8}'
        if pid in existing_ids:
            raise SystemExit(f'ID COLLISION: {pid}')
        post = {
            'id': pid,
            'handle': handle,
            'display_name': display,
            'avatar': avatar,
            'content': '.',
            'timestamp': ts_iso,
            'reply_to': None,
            'link': None,
            'image': img(fname),
            'image_alt': (
