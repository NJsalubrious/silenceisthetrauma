"""Generate a single 1200x630 social-share card as a proof of concept.
Target: @dominic_ryker.

If this looks right, the same template runs for all 91 character pages
in one batch. Built with Pillow only — no headless browser, no external
fonts beyond what Windows ships with.
"""
import json, os, sys
from PIL import Image, ImageDraw, ImageFont, ImageFilter, ImageOps

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
PROFILES = os.path.join(HERE, 'profiles.json')
OUT_DIR = os.path.join(ROOT, 'assets', 'images', 'social_share')
os.makedirs(OUT_DIR, exist_ok=True)

# Fonts on Windows
FONT_SERIF       = r'C:\Windows\Fonts\georgia.ttf'
FONT_SERIF_ITAL  = r'C:\Windows\Fonts\georgiai.ttf'
FONT_SERIF_BOLD  = r'C:\Windows\Fonts\georgiab.ttf'
FONT_MONO        = r'C:\Windows\Fonts\consola.ttf'
FONT_SANS_BOLD   = r'C:\Windows\Fonts\arialbd.ttf'

# Canvas + palette
W, H = 1200, 630
BG          = (8, 6, 4)         # near-black warm
CREAM       = (237, 226, 200)   # vellum text
CREAM_DIM   = (180, 168, 144)   # secondary text
BRASS       = (212, 169, 76)    # accent
BRASS_DEEP  = (160, 122, 48)
OXBLOOD     = (94, 26, 26)

# Layout
AVATAR_SIZE = 440
AVATAR_X    = 84
AVATAR_Y    = (H - AVATAR_SIZE) // 2

TEXT_X      = AVATAR_X + AVATAR_SIZE + 70
TEXT_W      = W - TEXT_X - 60


def grainy_background():
    """Dark warm canvas with subtle paper-grain texture."""
    img = Image.new('RGB', (W, H), BG)
    # Add a faint vignette using a radial-ish gradient
    g = Image.new('L', (W, H), 0)
    gd = ImageDraw.Draw(g)
    gd.ellipse((-300, -300, W + 300, H + 300), fill=70)
    g = g.filter(ImageFilter.GaussianBlur(180))
    glow = Image.new('RGB', (W, H), (28, 20, 10))
    img = Image.composite(glow, img, g)
    # Add small noise grain
    import random
    noise = Image.new('L', (W, H))
    nd = noise.load()
    rng = random.Random(0xA17E1)
    for y in range(H):
        for x in range(W):
            nd[x, y] = rng.randint(0, 16)
    grain_overlay = Image.merge('RGB', (noise, noise, noise))
    img = Image.blend(img, grain_overlay, 0.06)
    return img


def circular_avatar(path, size):
    src = Image.open(path).convert('RGB')
    src = ImageOps.fit(src, (size, size), Image.LANCZOS, centering=(0.5, 0.4))
    mask = Image.new('L', (size, size), 0)
    md = ImageDraw.Draw(mask)
    md.ellipse((0, 0, size, size), fill=255)
    out = Image.new('RGBA', (size, size), (0, 0, 0, 0))
    out.paste(src, (0, 0), mask)
    # Brass rim
    rim = Image.new('RGBA', (size + 12, size + 12), (0, 0, 0, 0))
    rd = ImageDraw.Draw(rim)
    rd.ellipse((0, 0, size + 11, size + 11), outline=BRASS, width=3)
    return out, rim


def wrap_text(text, font, max_w, draw):
    words = text.split()
    lines, line = [], ''
    for w in words:
        candidate = (line + ' ' + w).strip()
        bbox = draw.textbbox((0, 0), candidate, font=font)
        if bbox[2] - bbox[0] <= max_w:
            line = candidate
        else:
            if line:
                lines.append(line)
            line = w
    if line:
        lines.append(line)
    return lines


def render_card(profile, out_path):
    img = grainy_background()
    draw = ImageDraw.Draw(img)

    # Brass left accent line
    draw.rectangle((0, 0, 6, H), fill=BRASS)

    # Avatar
    avatar_src = os.path.normpath(
        os.path.join(HERE, profile['avatar'])
    )
    if not os.path.isfile(avatar_src):
        raise SystemExit(f'AVATAR MISSING: {avatar_src}')
    av, rim = circular_avatar(avatar_src, AVATAR_SIZE)
    img.paste(rim, (AVATAR_X - 6, AVATAR_Y - 6), rim)
    img.paste(av, (AVATAR_X, AVATAR_Y), av)

    # Text column
    y = AVATAR_Y + 18

    # Display name — large serif
    name_font = ImageFont.truetype(FONT_SERIF_BOLD, 78)
    name_lines = wrap_text(profile['display_name'], name_font, TEXT_W, draw)
    for line in name_lines:
        draw.text((TEXT_X, y), line, font=name_font, fill=CREAM)
        y += 84

    # Handle in brass mono
    handle_font = ImageFont.truetype(FONT_MONO, 32)
    y += 4
    draw.text((TEXT_X, y), profile['handle'], font=handle_font, fill=BRASS)
    y += 56

    # Bio (italic serif)
    bio = profile.get('bio') or ''
    if bio:
        bio_font = ImageFont.truetype(FONT_SERIF_ITAL, 34)
        bio_lines = wrap_text(bio, bio_font, TEXT_W, draw)
        for line in bio_lines[:3]:
            draw.text((TEXT_X, y), line, font=bio_font, fill=CREAM_DIM)
            y += 44

    # Footer: brand mark in tracked uppercase
    footer_font = ImageFont.truetype(FONT_SANS_BOLD, 18)
    footer_text = "VEX  ·  SILENCEISTHETRAUMA.COM"
    fb = draw.textbbox((0, 0), footer_text, font=footer_font)
    fw = fb[2] - fb[0]
    draw.text((W - fw - 60, H - 50), footer_text,
              font=footer_font, fill=BRASS_DEEP)

    # Small verified tick if applicable
    if profile.get('verified'):
        v_font = ImageFont.truetype(FONT_SANS_BOLD, 24)
        # next to the display name's last line
        # find right edge of first name line:
        nb = draw.textbbox((TEXT_X, AVATAR_Y + 18),
                           name_lines[0], font=name_font)
        draw.text((nb[2] + 14, nb[1] + 18), '✓',
                  font=v_font, fill=BRASS)

    img.save(out_path, 'JPEG', quality=92, optimize=True)
    return out_path


def main():
    profiles = json.load(open(PROFILES, 'r', encoding='utf-8'))
    by_handle = {p['handle']: p for p in profiles}

    target = '@dominic_ryker'
    if target not in by_handle:
        raise SystemExit(f'NOT FOUND: {target}')
    profile = by_handle[target]

    out_filename = profile['id'] + '.jpg'
    out_path = os.path.join(OUT_DIR, out_filename)
    render_card(profile, out_path)
    print(f'Wrote: {out_path}')
    print(f'  size: 1200x630')
    print(f'  display: {profile["display_name"]}')
    print(f'  handle:  {profile["handle"]}')
    print(f'  bio:     {profile.get("bio")}')


if __name__ == '__main__':
    main()
