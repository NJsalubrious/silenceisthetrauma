  "lines": [
   {
    "t": 2.55,
    "end": 5.2,
    "text": "This is where my red dirt ends."
   },
   {
    "t": 6.55,
    "end": 8.6,
    "text": "Right here."
   },
   {
    "t": 11.15,
    "end": 14.8,
    "text": "You can do what I always do"
   },
   {
    "t": 16.75,
    "end": 19.2,
    "text": "and keep moving forward."
   },
   {
    "t": 20.25,
    "end": 23.2,
    "text": "Or you can do what I can't do"
   },
   {
    "t": 24.05,
    "end": 26.3,
    "text": "and go back to where it all began."
   },
   {
    "t": 26.95,
    "end": 29,
    "text": "To Gran and Pop."
   },
   {
    "t": 30.45,
    "end": 32,
    "text": "It's up to you."
