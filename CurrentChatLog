"""Inject Open Graph + Twitter Card meta tags for the social share image
into a single character HTML page. Idempotent — skips injection if
og:image already present.

Test target: ross_kinley_councillor.html
"""
import json, os, re
from datetime import datetime

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
PROFILES = os.path.join(HERE, 'profiles.json')

# Test target
PROFILE_HANDLE = '@ross_kinley'
PAGE_PATH = os.path.join(ROOT, 'people', 'ross_kinley_councillor.html')
SHARE_DIR_REL = 'assets/images/social_share'
SITE_BASE = 'https://silenceisthetrauma.com'


def find_profile(handle):
    profiles = json.load(open(PROFILES, 'r', encoding='utf-8'))
    for p in profiles:
        if p.get('handle') == handle:
            return p
    raise SystemExit(f'PROFILE NOT FOUND: {handle}')


def build_meta_block(profile, image_filename):
    title = profile['display_name']
    desc  = profile.get('bio', '').strip()
    image_url = f"{SITE_BASE}/{SHARE_DIR_REL}/{image_filename}"
    return (
        '\n    <!-- Open Graph / social share -->\n'
        f'    <meta property="og:type" content="profile">\n'
        f'    <meta property="og:title" content="{title}">\n'
        f'    <meta property="og:description" content="{desc}">\n'
        f'    <meta property="og:image" content="{image_url}">\n'
        '    <meta property="og:image:width" content="1200">\n'
        '    <meta property="og:image:height" content="630">\n'
        '    <meta name="twitter:card" content="summary_large_image">\n'
        f'    <meta name="twitter:title" content="{title}">\n'
        f'    <meta name="twitter:description" content="{desc}">\n'
        f'    <meta name="twitter:image" content="{image_url}">\n'
    )


def main():
    profile = find_profile(PROFILE_HANDLE)
    image_filename = profile['id'] + '.jpg'

    # Verify the image actually exists
    image_disk = os.path.join(
        ROOT, 'assets', 'images', 'social_share', image_filename
    )
    if not os.path.isfile(image_disk):
        raise SystemExit(f'IMAGE MISSING: {image_disk}')

    with open(PAGE_PATH, 'r', encoding='utf-8') as f:
        html = f.read()

    if 'og:image' in html:
        print(f'SKIPPED — og:image already present in {PAGE_PATH}')
        return

    block = build_meta_block(profile, image_filename)

    # Insert after the og:url line (which we know is there from the head inspection).
    og_url_match = re.search(r'(<meta property="og:url"[^>]*>)', html)
    if og_url_match:
        insert_at = og_url_match.end()
        new_html = html[:insert_at] + block + html[insert_at:]
    else:
        # Fallback: insert just after <head>
        head_match = re.search(r'(<head[^>]*>)', html)
        if not head_match:
            raise SystemExit('NO <head> TAG FOUND')
        insert_at = head_match.end()
        new_html = html[:insert_at] + block + html[insert_at:]

    # Backup
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    with open(PAGE_PATH + f'.bak.{stamp}_og_inject', 'w',
              encoding='utf-8', newline='\n') as f:
        f.write(html)

    with open(PAGE_PATH, 'w', encoding='utf-8', newline='\n') as f:
        f.write(new_html)

    print(f'Backup: {PAGE_PATH}.bak.{stamp}_og_inject')
    print(f'Injected OG + Twitter meta for {profile["handle"]}')
    print(f'Image URL: {SITE_BASE}/{SHARE_DIR_REL}/{image_filename}')


if __name__ == '__main__':
    main()
