                "Ryker's security network."
            ),
            'type': 'post',
            'pinned': False,
        }
        posts.append(post)
        added.append((ts_iso, handle, fname, pid))

    with open(CUR, 'w', encoding='utf-8', newline='\n') as f:
        json.dump(posts, f, indent=2, ensure_ascii=False)
    json.load(open(CUR, 'r', encoding='utf-8'))

    print(f'Backup: posts.json.bak.{stamp}_russian_militants')
    print(f'Appended: {len(added)} posts')
    print()
    print(f'{"timestamp":<22}  {"handle":<12}  image')
    for ts_iso, handle, fname, pid in added:
        print(f'{ts_iso[:16]:<22}  {handle:<12}  {fname}')
    print()
    # Per-handle count
    from collections import Counter
    counts = Counter(t[1] for t in added)
    print('Per-handle counts:')
    for h, c in counts.items():
        print(f'  {h}: {c}')
    print(f'Total posts now: {len(posts)}')


if __name__ == '__main__':
    main()
